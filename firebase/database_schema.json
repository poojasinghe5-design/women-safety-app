{
  "_comment": "SafeHer Firebase Firestore Schema",

  "collections": {
    "users": {
      "_description": "User profiles and settings",
      "document_id": "Firebase Auth UID",
      "fields": {
        "name": "string",
        "email": "string",
        "phone": "string",
        "fcmToken": "string — Firebase Cloud Messaging device token",
        "createdAt": "timestamp",
        "profilePhoto": "string (Storage URL)",
        "voiceKeyword": "string — default: 'help me'",
        "emergencyContacts": [
          {
            "name": "string",
            "phone": "string — E.164 format (+91XXXXXXXXXX)",
            "relationship": "string (Mom, Dad, Sister, Friend...)",
            "userId": "string|null — if contact uses the app"
          }
        ],
        "settings": {
          "shakeToSOS": "boolean",
          "voiceActivation": "boolean",
          "autoRecord": "boolean",
          "shareLocationOnSOS": "boolean",
          "safeZones": [{"lat": "number", "lng": "number", "radius": "number", "name": "string"}]
        }
      }
    },

    "sos_alerts": {
      "_description": "Emergency SOS events",
      "document_id": "auto-generated",
      "fields": {
        "userId": "string — ref to users/{uid}",
        "timestamp": "timestamp",
        "status": "string — 'active' | 'resolved' | 'cancelled'",
        "location": {"lat": "number", "lng": "number"},
        "audioUrl": "string|null — Firebase Storage URL",
        "backendNotified": "boolean",
        "notifiedAt": "timestamp|null",
        "cancelledAt": "timestamp|null",
        "resolvedAt": "timestamp|null"
      }
    },

    "live_locations": {
      "_description": "Real-time location updates (1 doc per user, continuously updated)",
      "document_id": "Firebase Auth UID",
      "fields": {
        "lat": "number",
        "lng": "number",
        "accuracy": "number — GPS accuracy in meters",
        "speed": "number — m/s",
        "timestamp": "timestamp",
        "isSOS": "boolean — true during active SOS"
      }
    },

    "location_shares": {
      "_description": "Manual location sharing sessions",
      "document_id": "auto-generated",
      "fields": {
        "userId": "string",
        "sharedWith": ["string — list of user IDs"],
        "active": "boolean",
        "createdAt": "timestamp",
        "expiresAt": "timestamp|null"
      }
    },

    "area_reports": {
      "_description": "User-submitted unsafe area reports",
      "document_id": "auto-generated",
      "fields": {
        "lat": "number",
        "lng": "number",
        "description": "string",
        "severity": "integer — 1 (minor) to 5 (critical)",
        "timestamp": "timestamp",
        "userId": "string",
        "verified": "boolean",
        "upvotes": "integer"
      }
    }
  }
}
